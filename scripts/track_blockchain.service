# Chain tracker for the Martian Republic: reads each new Marscoin block and
# records civic transactions (applications, endorsements, proposals, votes).
#
# Install:
#   cp scripts/track_blockchain.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now track_blockchain
#
# Run exactly one instance. Two trackers race each other over the same blocks.
[Unit]
Description=Martian Republic chain tracker
After=network.target mysql.service

[Service]
User=root
WorkingDirectory=/var/www/martianrepublic.org/scripts
ExecStart=/usr/bin/python3 /var/www/martianrepublic.org/scripts/track_blockchain.py
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
